  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Điều khiển phiên học.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Bắt đầu</button>",
      "css": ".ds-button-primary{font-family:var(--font-interface,Arial,sans-serif);font-size:13px;font-weight:700;line-height:1.5;min-height:40px;padding:9px 16px;border-radius:8px;cursor:pointer;white-space:normal;box-shadow:none;background:var(--pm-primary,#69bfdf);color:var(--pm-primary-text,#102934);border:1px solid var(--pm-primary,#69bfdf);min-width:136px;}.ds-button-primary:hover{background:var(--pm-primary-hover,#59b4d5);border-color:var(--pm-primary-hover,#59b4d5);}.ds-button-primary:focus-visible{outline:2px solid var(--pm-accent,#1670a0);outline-offset:3px;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Đặt lại hoặc thử lưu lại.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Đặt lại</button>",
      "css": ".ds-button-secondary{font-family:var(--font-interface,Arial,sans-serif);font-size:13px;font-weight:700;line-height:1.5;min-height:40px;padding:9px 16px;border-radius:8px;cursor:pointer;white-space:normal;box-shadow:none;background:var(--pm-button,#e8f3f8);color:var(--pm-button-text,#21516b);border:1px solid var(--pm-button-border,#b2cedb);}.ds-button-secondary:hover{background:var(--pm-button-hover,#deedf4);border-color:var(--pm-accent,#1670a0);}.ds-button-secondary:focus-visible{outline:2px solid var(--pm-accent,#1670a0);outline-offset:3px;}"
    },
    {
      "name": "Duration Field",
      "kind": "input",
      "refersTo": "input-wrap",
      "description": "Thời lượng nguyên 1–180 phút; chỉnh khi sẵn sàng.",
      "html": "<label class=\"ds-field\">Thời gian học<span class=\"ds-input-wrap\"><input type=\"number\" min=\"1\" max=\"180\" step=\"1\" value=\"25\" aria-label=\"Thời gian học (1 đến 180 phút)\"><span>phút</span></span></label>",
      "css": ".ds-field{display:block;color:var(--pm-ink,#24364b);font-family:var(--font-interface,Arial,sans-serif);font-size:13px;font-weight:700;line-height:1.5;}.ds-input-wrap{display:flex;align-items:center;gap:10px;margin-top:8px;padding:8px 12px;background:var(--pm-surface,#edf1f4);border:1px solid var(--pm-border,#c4ced7);border-radius:8px}.ds-input-wrap input{width:100%;min-width:0;padding:2px;background:transparent;border:0;border-radius:2px;color:var(--pm-title,#132b43);font-family:var(--font-interface,Arial,sans-serif);font-size:18px;line-height:1.5;font-variant-numeric:tabular-nums;box-shadow:none}.ds-input-wrap>span{color:var(--pm-muted,#50657a);font-size:12px;font-weight:400}.ds-input-wrap input:focus-visible{outline:2px solid var(--pm-accent,#1670a0);outline-offset:3px}.ds-input-wrap input[aria-invalid=\"true\"]{outline:2px solid var(--pm-error,#922e36);outline-offset:3px}.ds-input-wrap input:disabled{opacity:.65;cursor:not-allowed}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Khung dashboard và embed dùng chung.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-header\"><h2>Pomodoro</h2><span class=\"ds-status\"><span class=\"ds-dot\"></span>Sẵn sàng</span></header></section>",
      "css": ".ds-panel{width:100%;max-width:640px;border:1px solid var(--pm-border,#c4ced7);border-radius:16px;background:var(--pm-page,#f7fafc);overflow:hidden;font-family:var(--font-interface,Arial,sans-serif)}.ds-header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 24px}.ds-header h2{margin:0;color:var(--pm-title,#132b43);font-size:20px;font-weight:700;line-height:28px}.ds-status{display:flex;align-items:center;gap:7px;color:var(--pm-muted,#50657a);font-size:12px}.ds-dot{width:6px;height:6px;border-radius:50%;background:var(--pm-accent,#1670a0)}"
    },
    {
      "name": "Clock and Seven-segment LCD",
      "kind": "custom",
      "refersTo": "clock-shell",
      "description": "Vỏ chính diện; mẫu chữ số 2 dùng path SVG thật, không dùng font.",
      "html": "<div class=\"ds-clock\"><div class=\"ds-lcd\"><p class=\"ds-phase\">Thời gian học</p><svg class=\"ds-digits\" viewBox=\"0 0 54 94\" role=\"img\" aria-label=\"2\"><path d=\"M12 2H39L44 7L39 12H13L7 7Z\"/><path d=\"M46 10L50 15V39L45 44L40 39V16Z\"/><path d=\"M45 46L50 51V75L46 81L40 75V52Z\" class=\"ds-hidden\"/><path d=\"M13 78H39L44 83L39 88H12L7 83Z\"/><path d=\"M5 46L10 52V75L4 81L0 75V51Z\"/><path d=\"M4 10L10 16V39L5 44L0 39V15Z\" class=\"ds-hidden\"/><path d=\"M12 40H39L44 45L39 50H12L6 45Z\"/></svg></div></div>",
      "css": ".ds-clock{position:relative;margin:20px 24px 0;padding:17px 17px 21px;background:var(--pm-shell,#78c49b);border:3px solid var(--pm-shell-border,#428264);border-radius:30px;box-shadow:inset 0 4px 0 var(--pm-shell-light,#a0d5b8),inset 0 -7px 0 var(--pm-shell-shade,#5bac83),0 8px 16px var(--pm-shadow,#122d3d14)}.ds-clock:before{content:\"\";position:absolute;left:18%;top:-11px;width:64%;height:10px;background:var(--pm-top,#8acba8);border:3px solid var(--pm-shell-border,#428264);border-bottom:0;border-radius:5px 5px 0 0;box-shadow:inset 0 3px 0 var(--pm-top-light,#b0ddc3)}.ds-lcd{padding:24px 18px 22px;background:var(--pm-lcd,#e3e7e4);border:3px solid var(--pm-shell-border,#428264);border-radius:16px;box-shadow:inset 0 3px 0 var(--pm-lcd-shadow,#cbd2d0)}.ds-phase{margin:0 0 24px;text-align:center;color:#303b3e;font:700 14px var(--font-interface,Arial,sans-serif)}.ds-digits{display:block;width:100%;height:138px;fill:var(--pm-lcd-ink,#171c20)}.ds-digits path{stroke:var(--pm-lcd-ink,#171c20);stroke-width:1.2;stroke-linejoin:round}.ds-hidden{opacity:.045}"
    }
  ],
  "narrative": {
    "northStar": "Đồng hồ học tập chính diện",
    "overview": "Thiết kế đã duyệt mô phỏng đồng hồ nhìn chính diện: vỏ xanh lục bo góc, thanh nhô phía trên, mặt LCD xám và số đen bảy đoạn nét dày góc vát. Nút xanh da trời là điểm thao tác rõ ràng.\n\nĐây là giao diện công cụ đang vận hành (Operate): trạng thái, thời gian và thao tác phiên học hiện diện trực tiếp. Tên ẩn dụ bên dưới là mô tả tài liệu cho thiết kế hiện hành, không phải một tuyên bố thương hiệu mới của người dùng. Các kích thước và token trích từ CSS là lựa chọn triển khai.",
    "keyCharacteristics": [
      "Góc chính diện, vỏ xanh lục và thanh nhô dài 64%.",
      "LCD xám trong cả theme sáng và tối.",
      "Chữ số SVG bảy đoạn, nét ẩn opacity 0.045.",
      "Nút xanh da trời và bố cục theo chiều rộng vùng nhúng."
    ],
    "rules": [
      {
        "name": "The Gray LCD Rule",
        "body": "Mặt LCD vẫn xám và số vẫn đen khi theme Obsidian thay đổi.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do giữ mặt LCD xám và nét số đen trong cả hai theme.",
      "Do dùng SVG bảy đoạn cho thời gian và văn bản truy cập được cho trình đọc màn hình.",
      "Do đáp ứng chiều rộng container để cùng thiết kế dùng được trong dashboard và note."
    ],
    "donts": [
      "Don't thay chữ số SVG bằng font seven-segment.",
      "Don't thêm nút đổi theme riêng hoặc thanh điều khiển mockup.",
      "Don't làm nét ẩn đậm hơn opacity 0.045 trong hệ hiện hành."
    ]
  }
